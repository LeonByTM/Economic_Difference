# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Data (raw/processed data should not be in source control unless needed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
